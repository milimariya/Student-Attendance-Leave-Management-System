# Oracle Database Connection Configuration
# Copy this file to secrets.toml in the same folder (.streamlit/secrets.toml)
# and fill in your Oracle DB credentials.

[oracle]
user = "system"
password = "your_oracle_password"
# DSN format: host:port/service_name or host:port:SID
dsn = "localhost:1521/ORCL"
# For older Oracle 10g/11g SID style, you can use:
# dsn = "localhost:1521:ORCL"

